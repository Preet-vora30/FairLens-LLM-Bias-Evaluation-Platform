# FairLens AI — Environment Configuration (example)
# Copy to backend/.env and adjust. Never commit real secrets.

PROJECT_NAME="FairLens AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database & Cache Storage
DATABASE_URL="sqlite:///./fairlens.db"
MODEL_CACHE_DIR="./cache/models"
DATASET_CACHE_DIR="./cache/datasets"
REPORTS_DIR="./reports"

# Compute Settings
DEFAULT_DEVICE="cpu"
ALLOW_CUDA=True
BATCH_SIZE=8
MAX_SEQUENCE_LENGTH=128
SEED=42
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Optional: Hugging Face Hub token for higher rate limits (do not commit).
# HF_TOKEN=""
